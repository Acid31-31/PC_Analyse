<Window x:Class="PCAnalyse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Analyse" Height="820" Width="1180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2836"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C62828"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeaderUtilityBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2836"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarBtnActive" TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="22,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BrowseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="96"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource GroupBorder}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="24,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="68" Height="68" CornerRadius="12"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="PC" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="PC Analyse" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource HeaderForeground}"/>
                    <TextBlock Text="Rechner anlegen und für den Agent freigeben"
                               FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderUtilityBtn}" Click="CheckForUpdates_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⟳" Margin="0,0,6,0"/>
                            <TextBlock Text="Update"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderUtilityBtn}" Click="NavInfo_Click" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ⓘ" Margin="0,0,6,0"/>
                            <TextBlock Text="Info"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TitleBarBtn}" Content="—" Click="TitleBarMinimize_Click"/>
                    <Button Style="{StaticResource TitleBarBtn}" Content="▢" Click="TitleBarMaximize_Click"/>
                    <Button Style="{StaticResource TitleBarCloseBtn}" Content="✕" Click="TitleBarClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource GroupBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,16,0,0">
                    <Button x:Name="NavOverviewButton" Style="{StaticResource SidebarBtnActive}" Click="NavOverview_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" FontSize="16" Margin="0,0,10,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Übersicht" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSecondPcButton" Style="{StaticResource SidebarBtn}" Click="NavSecondPc_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖥" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Zweiter PC" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavLinkButton" Style="{StaticResource SidebarBtn}" Click="NavLink_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔗" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Verbindung" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Height="1" Margin="20,10,20,10" Background="{DynamicResource GroupBorder}"/>
                    <Button x:Name="NavInfoButton" Style="{StaticResource SidebarBtn}" Click="NavInfo_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ⓘ" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Info" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="SidebarVersionText" Grid.Row="1" Margin="20,0,20,14" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="PC Analyse"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="24,12,24,12"
              Background="{DynamicResource MainContentBackground}">
            <Grid x:Name="OverviewPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Dieser PC" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,16"/>
                <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                    <Border Margin="0,0,10,10" Padding="18" CornerRadius="8"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource GroupBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Style="{StaticResource InfoLabel}" Text="Rechnername"/>
                            <TextBlock x:Name="LocalNameText" Style="{StaticResource InfoValue}"/>
                            <TextBlock Style="{StaticResource InfoLabel}" Text="Benutzer" Margin="0,14,0,4"/>
                            <TextBlock x:Name="LocalUserText" Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="10,0,0,10" Padding="18" CornerRadius="8"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource GroupBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Style="{StaticResource InfoLabel}" Text="Betriebssystem"/>
                            <TextBlock x:Name="LocalOsText" Style="{StaticResource InfoValue}"/>
                            <TextBlock Style="{StaticResource InfoLabel}" Text="Prozessoren" Margin="0,14,0,4"/>
                            <TextBlock x:Name="LocalCpuText" Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,10,10,0" Padding="18" CornerRadius="8"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource GroupBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Style="{StaticResource InfoLabel}" Text="Arbeitsspeicher"/>
                            <TextBlock x:Name="LocalRamText" Style="{StaticResource InfoValue}"/>
                            <TextBlock Style="{StaticResource InfoLabel}" Text="Netzwerk" Margin="0,14,0,4"/>
                            <TextBlock x:Name="LocalNetText" Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="10,10,0,0" Padding="18" CornerRadius="8"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource GroupBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Style="{StaticResource InfoLabel}" Text="Laufwerke"/>
                            <TextBlock x:Name="LocalDiskText" Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <Grid x:Name="SecondPcPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Zweiter PC anlegen" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,8"/>
                <TextBlock Grid.Row="0" Margin="0,36,0,16" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="App auf dem zweiten Rechner starten und dort «Diesen PC für den Agent anlegen» wählen. Der Agent kann danach auf diesem Rechner arbeiten."/>

                <Border Grid.Row="1" Padding="18" CornerRadius="8" Margin="0,0,0,16"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource GroupBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Anzeigename" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox x:Name="DisplayNameBox" Grid.Column="1" Grid.ColumnSpan="2" MinHeight="38"/>
                        <TextBlock Grid.Row="2" Text="Hostname / IP" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox x:Name="HostnameBox" Grid.Row="2" Grid.Column="1" MinHeight="38" Margin="0,0,8,0"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="Prüfen" Style="{StaticResource BrowseBtn}"
                                MinWidth="110" Click="Ping_Click"/>
                        <TextBlock Grid.Row="4" Text="Projektordner" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox x:Name="ProjectPathBox" Grid.Row="4" Grid.Column="1" MinHeight="38" Margin="0,0,8,0"/>
                        <Button Grid.Row="4" Grid.Column="2" Content="Durchsuchen…" Style="{StaticResource BrowseBtn}"
                                MinWidth="110" Click="BrowseProject_Click"/>
                        <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Speichern" Style="{StaticResource SecondaryActionBtn}"
                                    Margin="0,0,10,0" Padding="18,10" Click="SavePc_Click"/>
                            <Button Content="Diesen PC für den Agent anlegen" Style="{StaticResource PrimaryActionBtn}"
                                    Padding="18,10" Click="RegisterLocalWorker_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Padding="18" CornerRadius="8"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource GroupBorder}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Angelegte Rechner" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                        <ListBox x:Name="PcList" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{DynamicResource InputBackground}"
                                                        BorderBrush="{DynamicResource GroupBorder}"
                                                        BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid x:Name="LinkPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Verbindung" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,8"/>
                <TextBlock Grid.Row="0" Margin="0,36,0,16" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="Auf dem zweiten PC «PCAnalyse.Verbindung» starten. Eine Maus für beide Rechner, Dateien rüberziehen, Screenshot und Zwischenablage teilen."/>
                <Border Grid.Row="1" Padding="18" CornerRadius="8" Margin="0,0,0,16"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource GroupBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="LinkStatusDetail" Text="Suche im Netzwerk …"
                                   Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MouseShareText" Margin="0,10,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="Maus: wartet auf Verbindung"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="Anderer PC steht" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <RadioButton x:Name="PeerRightRadio" Content="rechts" IsChecked="True" Margin="0,0,16,0"
                                         Foreground="{DynamicResource TextPrimary}" Checked="PeerSide_Changed"/>
                            <RadioButton x:Name="PeerLeftRadio" Content="links"
                                         Foreground="{DynamicResource TextPrimary}" Checked="PeerSide_Changed"/>
                        </StackPanel>
                        <Button Content="Maus auf den anderen PC" Style="{StaticResource PrimaryActionBtn}"
                                HorizontalAlignment="Left" Margin="0,16,0,0" Padding="18,10"
                                Click="SwitchMouse_Click"/>
                        <TextBlock x:Name="DeskShareText" Margin="0,14,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                   Text="Dateien: wartet auf Verbindung"/>
                        <Border Margin="0,12,0,0" Padding="14" CornerRadius="6"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                Background="{DynamicResource AccentSoftBrush}"
                                AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
                            <TextBlock Text="Dateien hierher ziehen – sie landen auf dem Desktop des anderen PC in «Von anderem PC»."
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                        </Border>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Screenshot vom anderen PC" Style="{StaticResource SecondaryActionBtn}"
                                    Margin="0,0,8,8" Padding="14,8" Click="ScreenshotPeer_Click"/>
                            <Button Content="Kopieren vom anderen PC" Style="{StaticResource SecondaryActionBtn}"
                                    Margin="0,0,8,8" Padding="14,8" Click="PullClipboard_Click"/>
                            <Button Content="Dateien senden" Style="{StaticResource SecondaryActionBtn}"
                                    Margin="0,0,8,8" Padding="14,8" Click="SendFiles_Click"/>
                            <Button Content="Empfangsordner" Style="{StaticResource SecondaryActionBtn}"
                                    Margin="0,0,8,8" Padding="14,8" Click="OpenDropFolder_Click"/>
                        </WrapPanel>
                        <ProgressBar x:Name="LinkProgress" IsIndeterminate="True" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Padding="18" CornerRadius="8"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource GroupBorder}" BorderThickness="1">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Verbinden"
                                    Style="{StaticResource PrimaryActionBtn}" Padding="18,10"
                                    Click="ConnectPeer_Click"/>
                            <TextBlock Text="Gefundene Rechner" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="PeerList" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid x:Name="InfoPanel" Visibility="Collapsed">
                <Border Padding="22" CornerRadius="8" VerticalAlignment="Top"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource GroupBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="PC Analyse" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="InfoVersionText" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                        <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="Lege den zweiten PC über «Verbindung» an. Dort startet PCAnalyse.Verbindung – ohne Passwort. Der Agent kann danach auf diesem Rechner arbeiten. Beide Programme aktualisieren sich über dasselbe GitHub-Release."/>
                        <Button Content="Nach Update suchen" Style="{StaticResource SecondaryActionBtn}"
                                HorizontalAlignment="Left" Margin="0,18,0,0" Padding="18,10"
                                Click="CheckForUpdates_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource FooterBackground}"
                BorderBrush="{DynamicResource GroupBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0,24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✓" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Bereit" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <TextBlock x:Name="PcCountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="0 Rechner angelegt"/>
            </Grid>
        </Border>
    </Grid>
</Window>
