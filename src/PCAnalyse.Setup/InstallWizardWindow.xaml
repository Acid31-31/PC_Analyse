<Window x:Class="PCAnalyse.Setup.InstallWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup" Height="620" Width="720"
        MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="WizardButton" TargetType="Button">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GroupBorder}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="WizardPrimaryButton" TargetType="Button" BasedOn="{StaticResource WizardButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="WizardTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="88"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource GroupBorder}" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitle" Text="Setup" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource HeaderForeground}"/>
                <TextBlock x:Name="StepTitleTextBlock" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="24,16,24,8" Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource GroupBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid>
                <StackPanel x:Name="WelcomePanel">
                    <TextBlock Text="Willkommen beim Installationsassistenten" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="WelcomeText" TextWrapping="Wrap" FontSize="14" LineHeight="22"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <StackPanel x:Name="OptionsPanel" Visibility="Collapsed">
                    <TextBlock Text="Installationsordner" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Zielordner:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetPathTextBox" Style="{StaticResource WizardTextBox}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Durchsuchen…" Style="{StaticResource WizardButton}"
                                MinWidth="120" Click="Browse_Click"/>
                    </Grid>
                    <CheckBox x:Name="LaunchCheckBox" Content="Nach der Installation starten" IsChecked="True"
                              Foreground="{DynamicResource TextPrimary}" Margin="0,16,0,0"/>
                </StackPanel>

                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Installation läuft…" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <ProgressBar Height="8" IsIndeterminate="True" Margin="40,0"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ProgressTrack}"/>
                    <TextBlock x:Name="ProgressStatusTextBlock" Margin="0,16,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <StackPanel x:Name="FinishPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="FinishTitle" Text="Installation abgeschlossen" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock x:Name="FinishMessageTextBlock" TextWrapping="Wrap" FontSize="14" LineHeight="22"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource GroupBorder}" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel LastChildFill="False">
                <Button x:Name="CancelButton" Content="Abbrechen" Click="Cancel_Click"
                        Style="{StaticResource WizardButton}" DockPanel.Dock="Left"/>
                <Button x:Name="NextButton" Content="Weiter" Click="Next_Click"
                        Style="{StaticResource WizardPrimaryButton}" DockPanel.Dock="Right"/>
                <Button x:Name="InstallButton" Content="Installieren" Click="Install_Click"
                        Style="{StaticResource WizardPrimaryButton}" DockPanel.Dock="Right" Visibility="Collapsed"/>
                <Button x:Name="FinishButton" Content="Fertig" Click="Finish_Click"
                        Style="{StaticResource WizardPrimaryButton}" DockPanel.Dock="Right" Visibility="Collapsed"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
